<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#090E0C</item>
        <item name="android:navigationBarColor">#090E0C</item>
        <item name="android:windowBackground">#090E0C</item>
        <item name="android:colorAccent">#A9DBBD</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="AppTheme.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090E0C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
