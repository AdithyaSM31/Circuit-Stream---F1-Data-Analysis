{
  "name": "f1-data-analysis-frontend",
  "version": "2.0.0",
  "description": "Real-time F1 Data Analysis Frontend",
  "private": true,
  "dependencies": {
    "axios": "^1.13.5",
    "axios-cache-interceptor": "^1.11.4",
    "f1-project": "file:..",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.10.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prebuild": "eslint src --ext .js --no-cache",
    "android:prepare": "node scripts/prepare-android.cjs",
    "android:debug": "npm run android:prepare && node scripts/run-android-gradle.cjs assembleDebug",
    "android:release": "npm run android:prepare && node scripts/run-android-gradle.cjs assembleRelease bundleRelease"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "22.x"
  }
}
